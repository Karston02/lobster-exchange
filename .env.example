# Copy to .env (gitignored) and fill in. Real environment variables override this file.
# Relative paths count from the repo root; ~ is your home folder.

# Schwab app credentials, from developer.schwab.com
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# SCHWAB_TOKEN_PATH=~/.lobster/schwab_token.json   # default: <LOBSTER_STATE_DIR>/schwab_token.json

# Where things live
# LOBSTER_DATA_DIR=data            # market data recordings
# LOBSTER_STATE_DIR=~/.lobster     # login token and database (keep it outside the repo)
# LOBSTER_DB_PATH=~/.lobster/lobster.db   # default: <LOBSTER_STATE_DIR>/lobster.db

# The Lobster server (local only until the app has a login)
# LOBSTER_HOST=127.0.0.1
# LOBSTER_PORT=8000
